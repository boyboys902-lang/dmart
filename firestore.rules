rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // ───────────────────────────────────────────────────────────────────────
    // Simple / open rules (requested): any visitor can read and write
    // products, orders, customers, carts and settings without signing in.
    //
    // ⚠️  This means anyone who knows the project ID can also delete or edit
    // your data. If you later want it locked down, replace the block below
    // with the login-only version at the bottom of this file.
    // ───────────────────────────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if true;
    }

    // ── Login-only version (swap in when you want it secure) ───────────────
    // function signedIn() { return request.auth != null; }
    //
    // match /orders/{orderId} {
    //   allow create: if true;
    //   allow read, update, delete: if signedIn();
    // }
    // match /products/{productId} {
    //   allow read: if true;
    //   allow write: if signedIn();
    // }
    // match /settings/{docId} {
    //   allow read: if true;
    //   allow write: if signedIn();
    // }
    // match /customers/{customerId} {
    //   allow read, write: if signedIn();
    // }
    // match /carts/{deviceId} {
    //   allow read, write: if true;
    // }
  }
}
